# Copy to .env and fill in:   cp .env.example .env
# .env is gitignored. Never commit it, the JSON key, or any real token.
# `bash scripts/setup-google-access.sh` walks through getting every value.

# Google Cloud project that owns the service account, with the Sheets, Drive
# and Cloud Vision APIs enabled. Used by the setup wizard.
GCP_PROJECT_ID=your-project-id

# The service account the app acts as. Share the Workbook folder with this
# address as Editor. Used by the setup wizard's checks.
GOOGLE_SERVICE_ACCOUNT_EMAIL=mousai@your-project-id.iam.gserviceaccount.com

# Path to the service account's JSON key, relative to the repo root. Keep it
# under secrets/, which is gitignored.
GOOGLE_APPLICATION_CREDENTIALS=secrets/service-account.json

# The Drive folder holding the monthly Workbooks: the <id> in
# https://drive.google.com/drive/folders/<id>. The app lists Workbooks from here.
MOUSAI_DRIVE_FOLDER_ID=

# This month's Workbook: the <id> in https://docs.google.com/spreadsheets/d/<id>.
# Only scripts/reconcile.py reads it; the web app finds Workbooks via the folder.
MOUSAI_SPREADSHEET_ID=

# A throwaway copy of the Workbook, kept OUTSIDE the folder, that tests and
# scripts may write to. The app hides it from the picker.
MOUSAI_TEST_SPREADSHEET_ID=

# Optional. When set, every page asks for this passcode first. Leave unset on
# a trusted network; set it before the app is reachable from the internet.
# MOUSAI_PASSCODE=

# Optional. Keeps passcode sessions across restarts. Unset, a restart signs
# everyone out.
# MOUSAI_SESSION_SECRET=

# Optional. The clinic's name, shown under the web page's title.
# MOUSAI_CLINIC_NAME=

# The Telegram bot's token from @BotFather. Paste it here on the machine that
# runs the bot; never into a chat or a commit.
# TELEGRAM_BOT_TOKEN=

# Optional. Who may use the bot, relative to the repo root. Copy
# people.example.toml to start. Defaults to people.toml.
# MOUSAI_PEOPLE_FILE=people.toml

# Optional. The bot's local store of unconfirmed Transactions, relative to
# the repo root. Defaults to mousai.db. Losing it loses only what was not
# yet confirmed.
# MOUSAI_STORE=mousai.db

# Optional. The local model that drafts Descriptions, served by Ollama on the
# machine that runs the bot. Unset or "none": no drafts, the bot asks instead.
# Chosen by scripts/eval_describer.py; see .scratch/telegram-bot/issues/04.
# MOUSAI_DESCRIBE_MODEL=aisingapore/Gemma-SEA-LION-v4-27B-IT
# MOUSAI_OLLAMA_URL=http://127.0.0.1:11434
